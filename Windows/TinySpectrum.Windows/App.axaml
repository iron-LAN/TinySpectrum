<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TinySpectrum.Windows.App">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBackground" Color="#071019"/>
          <SolidColorBrush x:Key="PanelBackground" Color="#101A24"/>
          <SolidColorBrush x:Key="GraphBackground" Color="#07131C"/>
          <SolidColorBrush x:Key="InputBackground" Color="#0B1822"/>
          <SolidColorBrush x:Key="ChipBackground" Color="#142633"/>
          <SolidColorBrush x:Key="PanelBorder" Color="#294153"/>
          <SolidColorBrush x:Key="GraphBorder" Color="#254457"/>
          <SolidColorBrush x:Key="RowBorder" Color="#263845"/>
          <SolidColorBrush x:Key="PrimaryText" Color="#E8F2F8"/>
          <SolidColorBrush x:Key="SecondaryText" Color="#8297A7"/>
          <SolidColorBrush x:Key="PresetText" Color="#E8F2F8"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBackground" Color="#EFF8FA"/>
          <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="GraphBackground" Color="#F8FCFD"/>
          <SolidColorBrush x:Key="InputBackground" Color="#F7FBFC"/>
          <SolidColorBrush x:Key="ChipBackground" Color="#DCEEF3"/>
          <SolidColorBrush x:Key="PanelBorder" Color="#AFCBD5"/>
          <SolidColorBrush x:Key="GraphBorder" Color="#8EB8C7"/>
          <SolidColorBrush x:Key="RowBorder" Color="#D4E3E8"/>
          <SolidColorBrush x:Key="PrimaryText" Color="#102A35"/>
          <SolidColorBrush x:Key="SecondaryText" Color="#456572"/>
          <SolidColorBrush x:Key="PresetText" Color="#173B49"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme/>
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Inter"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="13,7"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#10BFE8"/>
      <Setter Property="Foreground" Value="#041117"/>
    </Style>
    <Style Selector="Button.primary:disabled">
      <Setter Property="Background" Value="#172129"/>
      <Setter Property="Foreground" Value="#52616C"/>
      <Setter Property="Opacity" Value="0.72"/>
    </Style>
    <Style Selector="Button.purple">
      <Setter Property="Background" Value="#8B3FD1"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.purple:disabled">
      <Setter Property="Background" Value="#1C202A"/>
      <Setter Property="Foreground" Value="#52616C"/>
      <Setter Property="Opacity" Value="0.72"/>
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#3A2028"/>
      <Setter Property="Foreground" Value="#FF8092"/>
    </Style>
    <Style Selector="Button.danger:disabled">
      <Setter Property="Background" Value="#1A2026"/>
      <Setter Property="Foreground" Value="#52616C"/>
      <Setter Property="Opacity" Value="0.72"/>
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="{DynamicResource ChipBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.chip">
      <Setter Property="Background" Value="#142633"/>
      <Setter Property="BorderBrush" Value="#2D4A5D"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="11,5"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style Selector="Button.wwb">
      <Setter Property="Background" Value="#10BFE8"/>
      <Setter Property="Foreground" Value="#041117"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="8"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.scanSelector">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="3"/>
      <Setter Property="Width" Value="22"/>
      <Setter Property="Height" Value="22"/>
    </Style>
    <Style Selector="Button.scanDelete">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#8195A4"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="5"/>
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="26"/>
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#8195A4"/>
      <Setter Property="Padding" Value="7"/>
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#8DA4B4"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style Selector="Button.chipName">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="11,5"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource PresetText}"/>
    </Style>
    <Style Selector="Button.presetDelete">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#8195A4"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="7,5,9,5"/>
    </Style>
    <Style Selector="ToggleButton.peakHold">
      <Setter Property="Background" Value="#19232C"/>
      <Setter Property="Foreground" Value="#A9BAC7"/>
      <Setter Property="BorderBrush" Value="#3B4C59"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="11,5"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="ToggleButton.peakHold:checked">
      <Setter Property="Background" Value="#6B2028"/>
      <Setter Property="Foreground" Value="#FFCDD2"/>
      <Setter Property="BorderBrush" Value="#FF5968"/>
    </Style>
    <Style Selector="ComboBox, NumericUpDown, TextBox">
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style Selector="Border.sectionHeader">
      <Setter Property="Padding" Value="4,2,4,9"/>
    </Style>
    <Style Selector="Border.controlCard">
      <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="13"/>
    </Style>
    <Style Selector="Border.toolbarField">
      <Setter Property="Background" Value="#0B1720"/>
      <Setter Property="BorderBrush" Value="#294153"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="10,4"/>
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Application.Styles>
</Application>
