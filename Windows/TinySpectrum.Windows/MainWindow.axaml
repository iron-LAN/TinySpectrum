<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:TinySpectrum.Windows"
        x:Class="TinySpectrum.Windows.MainWindow"
        x:DataType="local:MainViewModel"
        Title="TinySpectrum" Width="1440" Height="900" MinWidth="1120" MinHeight="720"
        Background="#071019" RequestedThemeVariant="Dark">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Background="#101A24" BorderBrush="#294153" BorderThickness="0,0,0,1" Padding="18,12">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="12">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Width="30" Height="30" CornerRadius="8" Background="#112F3E" BorderBrush="#19D9FF" BorderThickness="1">
            <TextBlock Text="∿" FontSize="22" FontWeight="Bold" Foreground="#19D9FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel>
            <TextBlock Text="TinySpectrum" FontSize="19" FontWeight="Bold"/>
            <TextBlock Text="tinySA Ultra spectrum scanner" FontSize="10" Foreground="#7890A2"/>
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="1" Classes="toolbarField">
          <Grid ColumnDefinitions="Auto,120" ColumnSpacing="8">
            <TextBlock Text="AUTO CONNECT" FontSize="10" FontWeight="Bold" Foreground="#7890A2" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}" MinHeight="30"/>
          </Grid>
        </Border>
        <Button Grid.Column="2" Content="CONNECT" Command="{Binding ConnectCommand}" Classes="secondary"/>
        <Border Grid.Column="3" Classes="toolbarField">
          <Grid ColumnDefinitions="Auto,135" ColumnSpacing="8">
            <TextBlock Text="LOCATION" FontSize="10" FontWeight="Bold" Foreground="#7890A2" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="{Binding ExportLocation}" PlaceholderText="City" MinHeight="30"/>
          </Grid>
        </Border>
        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
          <Ellipse Width="8" Height="8" Fill="{Binding ConnectionColor}"/>
          <TextBlock Text="{Binding ConnectionText}" Foreground="#A9BAC7" FontWeight="Bold"/>
        </StackPanel>
        <Button Grid.Column="6" Content="DEMO" Command="{Binding DemoCommand}" Classes="secondary"/>
        <TextBlock Grid.Column="7" Text="WINDOWS BETA" FontSize="10" FontWeight="Bold" Foreground="#B56BFF" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="*,64,310" Margin="14" ColumnSpacing="10">
      <Grid RowDefinitions="Auto,*,Auto">
        <Border Classes="sectionHeader">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="SPECTRUM" Classes="sectionTitle"/>
            <ToggleSwitch Grid.Column="1" Content="Peak Hold" IsChecked="{Binding PeakHoldEnabled}"/>
          </Grid>
        </Border>
        <Border Grid.Row="1" Background="#07131C" BorderBrush="#254457" BorderThickness="1" CornerRadius="10">
          <local:SpectrumControl DataContext="{Binding}"/>
        </Border>
        <Border Grid.Row="2" Classes="controlCard" Margin="0,10,0,0">
          <StackPanel Spacing="10">
            <ItemsControl ItemsSource="{Binding Presets}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:ScanPreset">
                  <Button Content="{Binding Name}" Tag="{Binding .}" Click="Preset_Click" Classes="chip" Margin="0,0,8,0"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnDefinitions="Auto,120,Auto,120,Auto,*,Auto" ColumnSpacing="8">
              <TextBlock Text="START" Classes="fieldLabel"/>
              <NumericUpDown Grid.Column="1" Value="{Binding StartMhz}" Minimum="0.1" Maximum="5300" Increment="1" FormatString="0.######"/>
              <TextBlock Grid.Column="2" Text="STOP" Classes="fieldLabel"/>
              <NumericUpDown Grid.Column="3" Value="{Binding StopMhz}" Minimum="0.101" Maximum="5300" Increment="1" FormatString="0.######"/>
              <TextBlock Grid.Column="4" Text="MHz" Classes="fieldLabel"/>
              <TextBlock Grid.Column="6" Text="{Binding EstimatedSweepText}" VerticalAlignment="Center" Foreground="#8297A7" FontFamily="Consolas"/>
            </Grid>
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,230,130,Auto" ColumnSpacing="9">
              <Button Content="SCAN" Command="{Binding ScanCommand}" Classes="primary"/>
              <Button Grid.Column="1" Content="STOP" Command="{Binding StopCommand}" Classes="danger"/>
              <Button Grid.Column="2" Content="CONTINUOUS" Command="{Binding ContinuousCommand}" Classes="purple"/>
              <ComboBox Grid.Column="4" ItemsSource="{Binding RbwOptions}" SelectedItem="{Binding SelectedRbw}"/>
              <ComboBox Grid.Column="5" ItemsSource="{Binding IntervalOptions}" SelectedItem="{Binding SelectedInterval}"/>
              <local:CountdownControl Grid.Column="6" Width="42" Height="42" DataContext="{Binding}"/>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Column="1" Background="#0C1721" BorderBrush="#254052" BorderThickness="1" CornerRadius="10" Padding="8">
        <Grid RowDefinitions="Auto,*,Auto">
          <TextBlock Text="TIME" Classes="sectionTitle" HorizontalAlignment="Center"/>
          <Slider Grid.Row="1" Orientation="Vertical" Minimum="0" Maximum="{Binding TimelineMaximum}" Value="{Binding TimelineIndex}"
                  HorizontalAlignment="Center" Margin="0,12"/>
          <TextBlock Grid.Row="2" Text="{Binding TimelineIndex}" FontSize="10" Foreground="#8297A7" HorizontalAlignment="Center"/>
        </Grid>
      </Border>

      <Border Grid.Column="2" Background="#101820" BorderBrush="#294153" BorderThickness="1" CornerRadius="10" Padding="14">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
            <TextBlock Text="SCAN BROWSER" Classes="sectionTitle"/>
            <TextBlock Grid.Column="1" Text="{Binding VisibleCount, StringFormat={}{0} VISIBLE}" Margin="0,0,12,0" Foreground="#7890A2" FontSize="10" FontWeight="Bold"/>
            <Button Grid.Column="2" Content="Clear" Command="{Binding ClearCommand}" Classes="link"/>
          </Grid>
          <ListBox Grid.Row="1" ItemsSource="{Binding Scans}" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:SpectrumScan">
                <Border BorderBrush="#263845" BorderThickness="0,0,0,1" Padding="3,11">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                    <CheckBox IsChecked="{Binding IsVisible, Mode=OneWay}" Tag="{Binding .}" Click="Visibility_Click" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Rbw}" FontSize="10" Foreground="#8297A7" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding CaptureLabel}" FontSize="10" Foreground="#BE7BFF"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="WWB" Tag="{Binding .}" Click="Export_Click" Classes="wwb"/>
                    <Button Grid.Column="3" Content="×" Tag="{Binding .}" Click="Delete_Click" Classes="icon"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#101A24" BorderBrush="#294153" BorderThickness="0,1,0,0" Padding="15,8">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
        <Ellipse Width="7" Height="7" Fill="#19D9FF" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="#9DB0BE"/>
      </Grid>
    </Border>
  </Grid>
</Window>
